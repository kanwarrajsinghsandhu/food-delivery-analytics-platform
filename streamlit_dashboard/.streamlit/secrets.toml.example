# Snowflake Connection Configuration — Key Pair Authentication
# Copy this file to .streamlit/secrets.toml and fill in your credentials
#
# Key pair authentication is more secure than password authentication.
# Private keys are never stored in code and can be rotated without changing passwords.

[snowflake]
user = "your_snowflake_username"
private_key_path = "rsa_key.p8"         # Path to your private key (relative to .streamlit/ or absolute)
private_key_passphrase = ""              # Leave empty if key has no passphrase
account = "xy12345.us-east-1"            # Your account identifier (from Snowflake URL)
warehouse = "ZOMATO_WH"
database = "ZOMATO"
schema = "MARTS"

# NOTE: Before using this:
# 1. Generate a key pair (see KEYPAIR_SETUP.md)
# 2. Place rsa_key.p8 in the .streamlit/ directory
# 3. Register the public key in Snowflake (see KEYPAIR_SETUP.md)
# 4. Keep .streamlit/secrets.toml in .gitignore (it already is)
